// Strudel Starter 1

// double forward slash for commenting and annotating!

/* for multi-line
comment
writing */

// $: prefix = sound will play
// _$: prefix = sound will not play
// sounds can be commented (//) away also!

// global tempo set
setcpm(120/4)

// drums
// each drum part here treated separately for mixing and effects 
$: sound("bd bd bd bd").bank("mpc1000").gain(0.5)

$: sound("~ sd ~ sd").bank("mpc1000").gain(0.4)

$: sound("hh hh hh hh hh hh hh oh").bank("mpc1000").gain(0.3)

$: sound("~ clap:8 ~ clap:4").gain(0.6)

/* additional possible drums:
rim(rimshot), lt(low-tom), mt(mid-tom), ht(hi-tom), rd(ride), cr(crash)
*/

// bass

$: note("[[36 36] [~ 38] [39 39] [~ 43] [36 36] [~ 38] [39 39] [~ 43]]/2").sound("gm_synth_bass").gain(0.5)


// chords

$: note("[[48,55] [51,58]]/2 [[ ~ ~ ] [46, 53]]/4").sound("steinway").gain(0.4)

// melody 

$: note("[60@4 ~ 63@4 ~]/4").sound("gm_electric_guitar_muted, gm_flute").gain(0.5)
  .attack("<0.5, 0.7>")
  .decay(0.1)
  .sustain(0.5)
  .release(1.0)

_$: note("[67 65 63 65]/2").sound("gm_electric_guitar_muted, gm_flute").gain(0.5)
  .attack("<0.5, 0.7>")
  .decay(0.1)
  .sustain(0.5)
  .release(1.0)
