// $: prefix = sound will play
// _$: prefix = sound will not play
// sounds can be commented (//) away also!

// global tempo set
setcpm(120/4)

// drums
// each drum part here treated separately for mixing and effects 
$: sound("bd bd bd bd").bank("mpc1000").gain(0.5)

$: sound("~ sd ~ sd").bank("mpc1000").gain(0.4)

$: sound("hh hh hh hh hh hh hh oh").bank("mpc1000").gain(0.3)

$: sound("~ clap:8 ~ clap:4").gain(0.6)

